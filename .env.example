ADMIN_PASSWORD=CHANGE_TO_A_STRONG_PRIVATE_PASSWORD
SESSION_SECRET=CHANGE_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AVALAI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=8000
SEARCH_CACHE_TTL=900
MAX_SEARCHES_PER_HOUR=30
SEARCH_COOLDOWN=12
DEALER_MARGIN_PERCENT=5
DEALER_PREP_COST_TOMAN=10000000
DEALER_RISK_COST_TOMAN=0
DB_PATH=/app/data/davoodi.db

# Optional first-class market connectors. Each endpoint accepts POST JSON and returns {"items":[...]}.
# If empty, v21 uses a focused per-domain search fallback.
DOMAIN_CACHE_TTL=21600
MAX_DOMAIN_REQUESTS=6
SEARCH_REQUEST_DELAY=0
DIVAR_CONNECTOR_URL=
BAMA_CONNECTOR_URL=
HAMRAH_CONNECTOR_URL=
KHODRO45_CONNECTOR_URL=
KARNAMEH_CONNECTOR_URL=
SHEYPOOR_CONNECTOR_URL=

# حذف آگهی‌های قدیمی با تاریخ انتشار قابل اعتماد (روز)
MAX_LISTING_AGE_DAYS=60

# v24: search parallelism and maximum stale fallback age (seconds)
MAX_CONCURRENT_SEARCHES=3
MAX_STALE_AGE_SECONDS=3600

# v26: Real browser extraction for JS-rendered public vehicle listings.
# playwright=hydrated pages, auto=HTTP first + JS fallback, http=legacy only.
MARKET_FETCH_MODE=playwright
MAX_CONCURRENT_BROWSERS=2
MAX_DETAIL_PAGES_PER_SOURCE=6
# Never set PLAYWRIGHT_NO_SANDBOX=1 unless the sandbox is unavailable and
# the deployment is otherwise secured. Chromium is provided by Docker image.
PLAYWRIGHT_NO_SANDBOX=0
