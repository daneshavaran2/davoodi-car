ADMIN_PASSWORD=CHANGE_TO_A_STRONG_PRIVATE_PASSWORD
SESSION_SECRET=CHANGE_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AVALAI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=8000
SEARCH_CACHE_TTL=900
MAX_SEARCHES_PER_HOUR=30
SEARCH_COOLDOWN=12
DEALER_MARGIN_PERCENT=5
DEALER_PREP_COST_TOMAN=10000000
DEALER_RISK_COST_TOMAN=0
DB_PATH=/app/data/davoodi.db

# Optional first-class market connectors. Each endpoint accepts POST JSON and returns {"items":[...]}.
# If empty, v21 uses a focused per-domain search fallback.
DOMAIN_CACHE_TTL=900
MAX_DOMAIN_REQUESTS=6
SEARCH_REQUEST_DELAY=0
DIVAR_CONNECTOR_URL=
BAMA_CONNECTOR_URL=
HAMRAH_CONNECTOR_URL=
KHODRO45_CONNECTOR_URL=
KARNAMEH_CONNECTOR_URL=
SHEYPOOR_CONNECTOR_URL=

# حذف آگهی‌های قدیمی با تاریخ انتشار قابل اعتماد (روز)
MAX_LISTING_AGE_DAYS=60

# v24 — search safety, per-session limits and actual job progress
STALE_MAX_AGE_SECONDS=21600
CONCURRENT_SEARCHES=3
JOB_MAX_PENDING=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900
