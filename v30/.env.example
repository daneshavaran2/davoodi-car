# Web and worker need the SAME PostgreSQL database. Never commit real secrets.
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
# Use Liara PostgreSQL private connection endpoint in production, NOT the Docker Compose host "postgres".
# DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@LIARA_PRIVATE_PG_HOST:PORT/DB_NAME
# Local Docker Compose sets DATABASE_URL from POSTGRES_PASSWORD automatically.
DATABASE_URL=postgresql://davoodi:CHANGE_THIS_PASSWORD@postgres:5432/davoodicar
ADMIN_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SCHEDULER_TZ=Asia/Tehran
MAX_PAGES_PER_SOURCE=8
FRONTEND_DIST=/app/frontend/dist
PORT=8000
# Set web or worker as an env var in the TWO different Liara Docker apps.
SERVICE_ROLE=web

# Only configure an endpoint after obtaining a permitted feed/API.
# All sources start disabled in PostgreSQL; the admin can enable them.
SOURCE_DIVAR_API_URL=
SOURCE_DIVAR_API_TOKEN=
SOURCE_BAMA_API_URL=
SOURCE_BAMA_API_TOKEN=
SOURCE_SHEYPOOR_API_URL=
SOURCE_SHEYPOOR_API_TOKEN=
SOURCE_HAMRAH_API_URL=
SOURCE_HAMRAH_API_TOKEN=
SOURCE_KARNAMEH_API_URL=
SOURCE_KARNAMEH_API_TOKEN=
SOURCE_KHODRO45_API_URL=
SOURCE_KHODRO45_API_TOKEN=

# Database readiness retries on application/worker startup.
DB_WAIT_ATTEMPTS=12
DB_WAIT_INTERVAL=3

# Nemuda public aggregate prices (CC BY 4.0); do not use as ad-level evidence.
NEMUDA_MAX_PATHS=60
# Optional exact documented API leaf paths, comma-separated, if index discovery fails:
# NEMUDA_TARGET_PATHS=car/samand/soren-plus-xu7p-petrol/1404

# v30.6: public Bama/Divar/Hamrah parsing happens automatically in Worker
# when the corresponding site is enabled and SOURCE_*_API_URL is absent.
# Bounded pilot, never circumvents CAPTCHA, authentication, HTTP 403/429.
MARKET_FETCH_MODE=playwright
PUBLIC_PILOT_MODELS=فیدلیتی پرایم,سانتافه
PUBLIC_PILOT_CAR_LIMIT=2
PUBLIC_PILOT_AD_LIMIT=8
MAX_DETAIL_PAGES_PER_SOURCE=4
# To FORCE an approved provider feed rather than public pages:
# SOURCE_BAMA_MODE=feed
# SOURCE_BAMA_API_URL=https://your-permitted-provider.example/api/cars
