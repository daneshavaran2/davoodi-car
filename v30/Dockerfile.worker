# Dedicated Liara Worker: no React build, no API web service.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app \
    PORT=8000 SERVICE_ROLE=worker SCHEDULER_TZ=Asia/Tehran
WORKDIR /app
RUN groupadd -r davoodi && useradd --no-log-init -r -g davoodi -m davoodi
COPY requirements.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt
COPY backend ./backend
COPY scripts ./scripts
COPY database ./database
COPY data/vehicle_catalog.csv ./data/vehicle_catalog.csv
RUN python -m compileall -q /app/backend /app/scripts
USER davoodi
EXPOSE 8000
# This port serves health checks only, not the price-search UI.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
  CMD python -c "from urllib.request import urlopen; import os; urlopen('http://127.0.0.1:'+os.environ.get('PORT','8000')+'/api/live',timeout=3)" || exit 1
CMD ["python", "-m", "scripts.worker_liara"]

